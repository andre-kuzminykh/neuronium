# AI Provider Keys (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Workspace root directory (where cloned repos go)
WORKSPACE_ROOT=./workspaces

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./neuronium.db

# Logging
LOG_LEVEL=INFO
